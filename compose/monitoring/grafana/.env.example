# Env do Grafana

OBS_BIND_IP=

# Acesso ao Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# LDAP
LDAP_HOST=ldap.example.local
LDAP_BIND_DN=CN=grafana-service,OU=Services,DC=example,DC=local
LDAP_BIND_PASSWORD=change_me
GRAFANA_ADMIN_GROUP=CN=Grafana Admins,OU=Groups,DC=example,DC=local
GRAFANA_EDITOR_GROUP=CN=Grafana Editors,OU=Groups,DC=example,DC=local
GRAFANA_VIEWER_GROUP=CN=Grafana Viewers,OU=Groups,DC=example,DC=local

# Authentik (OAuth)
AUTHENTIK_CLIENT_ID=change_me
AUTHENTIK_CLIENT_SECRET=change_me

# Banco de dados MySQL externo (mesmo usado no CORE)
GRAFANA_DB_HOST=host.docker.internal
GRAFANA_DB_PORT=3306
GRAFANA_DB_NAME=grafana
GRAFANA_DB_USER=grafana
GRAFANA_DB_PASSWORD=change_me
